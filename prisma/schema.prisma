generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id            String    @id @default(uuid())
    email         String    @unique
    name          String?
    emailVerified Boolean   @default(false)
    onboarded     Boolean   @default(false)
    image         String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    sessions      Session[]
    accounts      Account[]
    members       Member[]

    @@map("user")
}

model Session {
    id        String   @id @default(uuid())
    expiresAt DateTime
    token     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    ipAddress String?
    userAgent String?
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([token])
    @@index([userId])
    @@map("session")
}

model Account {
    id                    String    @id @default(uuid())
    accountId             String
    providerId            String
    userId                String
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    @@index([userId])
    @@map("account")
}

model Verification {
    id         String   @id @default(uuid())
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([identifier])
    @@map("verification")
}

model Organization {
    id   String  @id @default(uuid())
    name String
    slug String  @unique
    logo String?

    latitude  Float?
    longitude Float?

    createdAt DateTime @default(now())

    members       Member[]
    roles         Role[]
    leaveTypes    LeaveType[]
    leaveRequests LeaveRequest[]
    leaveBalances LeaveBalance[]
    holidays      Holiday[]

    @@map("organization")
}

model Member {
    id             String   @id @default(uuid())
    organizationId String
    userId         String
    createdAt      DateTime @default(now())

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

    roleId            String?
    role              Role?              @relation(fields: [organizationId, roleId], references: [organizationId, id])
    departmentMembers DepartmentMember[]

    leaveRequests         LeaveRequest[] @relation("LeaveRequestMember")
    approvedLeaveRequests LeaveRequest[] @relation("LeaveRequestApprover")
    leaveBalances         LeaveBalance[] @relation("LeaveBalanceMember")

    @@unique([organizationId, userId])
    @@index([organizationId])
    @@index([userId])
    @@map("member")
}

model Role {
    id             String   @id @default(uuid())
    organizationId String
    name           String
    permissions    Json
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    members      Member[]

    @@unique([organizationId, id])
    @@unique([organizationId, name])
    @@index([organizationId])
    @@map("role")
}

model AttendanceRecord {
    id                 String    @id @default(cuid())
    employeeId         String
    organizationId     String
    date               DateTime  @db.Date
    clockIn            DateTime?
    clockOut           DateTime?
    totalHours         Float?
    overtimeHours      Float?
    status             String    @default("ABSENT")
    enteredByManagerId String?
    createdAt          DateTime  @default(now())

    workLog AttendanceWorkLog[]

    @@unique([employeeId, date])
    @@index([organizationId])
    @@index([organizationId, date])
    @@index([organizationId, employeeId])
    @@map("attendanceRecord")
}

// Add this new model:
model AttendanceWorkLog {
    id                 String    @id @default(cuid())
    attendanceRecordId String
    organizationId     String
    employeeId         String
    date               DateTime  @db.Date
    startTime          DateTime?
    endTime            DateTime?
    title              String? // ← add this
    notes              String?
    createdAt          DateTime  @default(now())

    attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

    @@index([attendanceRecordId])
    @@index([organizationId])
    @@index([organizationId, employeeId])
    @@index([organizationId, date])
    @@map("attendanceWorkLog")
}

model WorkHourPolicy {
    id                   String @id @default(cuid())
    organizationId       String @unique
    standardHoursPerDay  Float  @default(8)
    overtimeThreshold    Float  @default(8)
    lateThresholdMinutes Int    @default(15)
    workStartHour        Int    @default(9)
    workStartMinute      Int    @default(0)
    halfDayMaxHours      Float  @default(4)
    absentAfterHour      Int    @default(18)

    @@map("workHourPolicy")
}

model Department {
    id                 String   @id @default(cuid())
    organizationId     String
    name               String
    parentDepartmentId String?
    headMemberId       String?
    status             String   @default("ACTIVE")
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt

    parentDepartment Department?        @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    childDepartments Department[]       @relation("DepartmentHierarchy")
    members          DepartmentMember[]

    @@index([organizationId])
    @@index([organizationId, status])
    @@index([parentDepartmentId])
    @@index([headMemberId])
    @@map("department")
}

model DepartmentMember {
    id           String   @id @default(cuid())
    departmentId String
    memberId     String
    joinedAt     DateTime @default(now())

    department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
    member     Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)

    @@unique([departmentId, memberId])
    @@index([departmentId])
    @@index([memberId])
    @@map("departmentMember")
}

enum LeaveRequestStatus {
    PENDING
    APPROVED
    REJECTED
    CANCELLED
}

model LeaveType {
    id             String  @id @default(cuid())
    organizationId String
    name           String
    quota          Float
    carryForward   Boolean @default(false)
    isPaid         Boolean @default(true)
    color          String?

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    balances     LeaveBalance[]
    requests     LeaveRequest[]

    @@unique([organizationId, name])
    @@index([organizationId])
    @@index([organizationId, deletedAt])
    @@map("leave_type")
}

model LeaveRequest {
    id             String @id @default(cuid())
    organizationId String
    memberId       String
    leaveTypeId    String

    startDate DateTime           @db.Date
    endDate   DateTime           @db.Date
    days      Float
    reason    String?
    status    LeaveRequestStatus @default(PENDING)

    approvedById    String?
    approverComment String?

    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    cancelledAt DateTime?
    deletedAt   DateTime?

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    member       Member       @relation("LeaveRequestMember", fields: [memberId], references: [id], onDelete: Cascade)
    leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
    approvedBy   Member?      @relation("LeaveRequestApprover", fields: [approvedById], references: [id], onDelete: SetNull)

    @@index([organizationId])
    @@index([organizationId, memberId])
    @@index([organizationId, status])
    @@index([organizationId, leaveTypeId])
    @@index([organizationId, startDate])
    @@index([organizationId, startDate, endDate])
    @@index([approvedById])
    @@map("leave_request")
}

model LeaveBalance {
    id             String @id @default(cuid())
    organizationId String
    memberId       String
    leaveTypeId    String
    year           Int

    allocated      Float @default(0)
    used           Float @default(0)
    remaining      Float @default(0)
    carriedForward Float @default(0)
    lapsed         Float @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    member       Member       @relation("LeaveBalanceMember", fields: [memberId], references: [id], onDelete: Cascade)
    leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

    @@unique([organizationId, memberId, leaveTypeId, year])
    @@index([organizationId])
    @@index([organizationId, memberId, year])
    @@index([organizationId, leaveTypeId, year])
    @@map("leave_balance")
}

model Holiday {
    id             String   @id @default(cuid())
    organizationId String
    name           String
    holidayDate    DateTime @db.Date
    isHoliday      Boolean  @default(true)
    isRecurring    Boolean  @default(false)
    description    String?

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    @@index([organizationId])
    @@index([organizationId, holidayDate])
    @@index([organizationId, deletedAt])
    @@map("holiday")
}

model PublicHolidayMaster {
    id          String   @id @default(cuid())
    name        String
    date        DateTime @db.Date
    year        Int
    location    String   @default("IN-TN")
    description String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([date, name, location])
    @@index([year, location])
    @@map("public_holiday_master")
}
